<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 매크로 상시 감시를 위한 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 태블릿은 차량에 상시 거치되므로 재부팅 후 자동 복귀시킨다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 음성 명령. 상시 대기는 마이크 타입 포그라운드 서비스로만 허용된다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Android 11+는 다른 앱의 존재를 기본으로 숨긴다.
      선언하지 않으면 테슬라 앱이 깔려 있어도 "없음"으로 보여 스토어로 보내버린다.
    -->
    <!-- 매크로가 백그라운드에서 네이버 지도를 띄우려면 필요하다 (설정에서 사용자가 허용) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- GitHub 릴리스에서 새 버전 확인용. 차량 제어(BLE)는 인터넷을 쓰지 않는다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 매크로 "출발지 근처" 조건용. 위치 조건을 추가할 때만 요청한다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 백그라운드 폴링 중에도 위치를 읽으려면 감시 서비스에 location 타입이 있어야 한다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <queries>
        <package android:name="com.teslamotors.tesla" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- 네이버 지도 길안내 스킴 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nmap" />
        </intent>
    </queries>

    <application
        android:name=".TeslaMacroApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeslaMacro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.TeslaMacro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 런처 길게 누르기 · 어시스턴트가 읽는 바로가기 목록 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          외부에서 명령 하나만 실행하는 통로.
          자동화 앱·어시스턴트·홈 화면 바로가기가 여기로 들어온다.
        -->
        <activity
            android:name=".service.QuickActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!-- BROWSABLE은 뺀다 — 넣으면 아무 웹페이지 링크 한 줄로 unlock·트렁크가
                 확인 없이 실행된다. 자동화 앱·바로가기(명시적 VIEW 인텐트)는 그대로 동작한다 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="teslamacro" android:host="run" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MacroService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <service
            android:name=".service.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
