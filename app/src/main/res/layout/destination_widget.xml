<?xml version="1.0" encoding="utf-8"?>
<!-- 배경만 투명해지도록 글자·설정 버튼과 별도 이미지 층으로 둔다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/destination_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/destination_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/destination_widget_background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/widget_spacing">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/destination_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/destination_widget_title"
                android:textColor="@color/launcher_background"
                android:textStyle="bold"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/destination_widget_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/widget_touch_target"
                android:gravity="center_vertical"
                android:text="@string/destination_widget_input"
                android:textColor="@color/launcher_background"
                android:textSize="16sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/destination_widget_settings"
            android:layout_width="@dimen/widget_touch_target"
            android:layout_height="@dimen/widget_touch_target"
            android:padding="@dimen/widget_icon_padding"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="@string/destination_widget_appearance" />
    </LinearLayout>
</FrameLayout>
