<?xml version="1.0" encoding="utf-8"?>
<!-- 기존 두 줄 크기로 남은 위젯도 가운데 낮은 검색창으로 표시한다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/destination_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_height"
        android:layout_gravity="center_vertical">
        <ImageView
            android:id="@+id/destination_widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/destination_widget_background" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/widget_icon_padding"
            android:paddingEnd="@dimen/widget_spacing">
            <ImageView
                android:id="@+id/destination_widget_search"
                android:layout_width="@dimen/widget_touch_target"
                android:layout_height="@dimen/widget_touch_target"
                android:padding="@dimen/widget_icon_padding"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_search" />
            <TextView
                android:id="@+id/destination_widget_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/destination_widget_title"
                android:textColor="@color/launcher_background"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
