<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose가 실제 테마를 그리므로 여기는 첫 프레임 배경만 맞춘다 -->
    <style name="Theme.TeslaMacro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/void_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 밝은 배경이라 상태바 아이콘은 어둡게 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- 홈 화면에서 전송만 끝내고 돌아가며 키보드는 창 크기에 맞춰 올린다. -->
    <style name="Theme.TeslaMacro.QuickSend" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">95%</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
