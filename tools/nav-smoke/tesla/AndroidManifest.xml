<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.teslamotors.tesla">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />
    <instrumentation android:name="com.tesla.share.SelectionInstrumentation" android:targetPackage="com.teslamotors.tesla" />
    <application android:label="Tesla share fixture" android:theme="@android:style/Theme.Material.Light">
        <activity android:name="com.tesla.share.ShareActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
